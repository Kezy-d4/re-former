<%= form_with model: @user do |form| %>
  <% if @user.errors.any? %>
    <ul>
      <% @user.errors.full_messages.each do |err| %>
        <li>
          <%= err %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <p>
    <%= form.label :name, "Enter your name:" %>
    <%= form.text_field :name, value: "Bob" %>
  </p>
  <p>
    <%= form.label :email, "Enter your email:" %>
    <%= form.email_field :email, placeholder: "you@example.com" %>
  </p>
  <p>
    <%= form.label :password, "Enter a password:" %>
    <%= form.password_field :password %>
  </p>
  <p>
    <%= form.submit %>
  </p>
<% end %>